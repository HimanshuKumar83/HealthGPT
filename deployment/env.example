# ==============================================================================
# Zentra HealthGPT Backend Environment Configuration Template
# ==============================================================================

# Execution Environment (development / production)
ENVIRONMENT=production

# Server Settings
APP_HOST=0.0.0.0
APP_PORT=8000

# Security (JWT token signing details)
# Run `openssl rand -hex 32` to generate a secure secret key
SECRET_KEY=your-super-secret-key-change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=600

# Database Settings
# Local Database URL:
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/healthgpt
# Render/Production Database URL:
# DATABASE_URL=postgresql+psycopg://user:password@host.oregon-postgres.render.com/healthgpt

# Caching & Session Store
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Generative AI Core Integration
# Request an API Key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# Vector Store Setup
# Embeddings types: google (production) / huggingface (local fallback)
EMBEDDING_TYPE=google
CHROMA_PATH=chroma_db
CHROMA_COLLECTION=health_knowledge
RAG_TOP_K=3

# SMTP Server for Email verification (Optional)
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=info@healthgpt.com
MAIL_FROM_NAME=HealthGPT
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587

# Allowed Frontend Origin (CORS validation)
FRONTEND_URL=https://healthgpt-frontend.vercel.app
